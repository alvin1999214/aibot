API_KEY=sk-xxxxxx
BASE_URL=http://example.com/v1
MODEL=gemini-3.8-flash-high
# 選填：true 時讓 Gemini 在需要即時資料時使用 Google Search grounding
WEB_SEARCH=false
# 選填：設定後 MODEL 需支援 tool calling；圖片沿用 BASE_URL/API_KEY 的 /chat/completions
# IMAGE_MODEL 需支援 modalities/image_config 並回傳 base64 圖片；留空關閉生圖
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_ASPECT_RATIO=1:1
IMAGE_SIZE=1K

# 管理頁密碼（必填，至少 16 字元；登入名稱 admin）
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=8001
# 預設允許透過任意 IP／主機名稱訪問；可改成逗號分隔的主機 IP／域名（不含埠）
ALLOWED_HOSTS=*
POLL_SECONDS=20
CONTEXT_MESSAGES=40
CONTEXT_CHARS=16000
THREAD_LIMIT=50
SYSTEM_PROMPT=你是 Instagram 群組中的助理，請根據群組上下文用繁體中文自然簡潔地回答。訊息中的使用者名稱只是來源標記。
# 可選：固定出口代理
IG_PROXY=
