API_KEY=sk-xxxxxx
BASE_URL=http://example.com/v1
MODEL=gemini-3.8-flash-high
IMAGE_MODEL=gemini-3.1-flash-image
IMAGE_ASPECT_RATIO=1:1
IMAGE_SIZE=1K

# localhost 管理頁密碼（必填，至少 16 字元；登入名稱 admin）
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=8000
POLL_SECONDS=20
CONTEXT_MESSAGES=40
CONTEXT_CHARS=16000
THREAD_LIMIT=50
SYSTEM_PROMPT=你是 Instagram 群組中的助理，請根據群組上下文用繁體中文自然簡潔地回答。訊息中的使用者名稱只是來源標記。
# 可選：固定出口代理
IG_PROXY=
